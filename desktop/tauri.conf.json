{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trace Gateway",
  "version": "0.2.0",
  "identifier": "dev.trace.gateway",
  "build": {
    "frontendDist": "../gateway/public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local agent trajectory gateway",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/trace",
      "binaries/trace-background"
    ],
    "resources": {
      "../runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
